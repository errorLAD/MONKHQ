# ==============================================================================
# MonkHQ Environment Configuration Template
# ==============================================================================
# Use this template for local development (.env) and production deployment (Vercel).
# On Vercel: Add these variables in Project Settings -> Environment Variables.
# NEVER commit your actual .env file or production secrets to Git.
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
# Set to 'config.settings.production' on Vercel, 'config.settings.development' locally
DJANGO_SETTINGS_MODULE=config.settings.production

# Set to False in production (Vercel)
DEBUG=False

# Generate a strong 50+ character random secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your_production_secret_key_minimum_50_chars_random_string_here_2026!

# Comma-separated allowed hostnames (include .vercel.app for Vercel preview/production URLs)
ALLOWED_HOSTS=.vercel.app,monkhq.in,www.monkhq.in,localhost,127.0.0.1

# Comma-separated trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://monkhq.in,https://www.monkhq.in,http://localhost:8000,http://127.0.0.1:8000

# SSL Redirection: Keep False on Vercel as Vercel Edge proxies handle SSL termination
SECURE_SSL_REDIRECT=False


# --- DATABASE CONFIGURATION ---
# Local SQLite default:
# DATABASE_URL=sqlite:///db.sqlite3

# Production PostgreSQL (Neon, Supabase, Vercel Postgres, AWS RDS):
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/monkhq?sslmode=require


# --- CACHE & CELERY (REDIS) ---
# For Vercel Serverless: If omitted or localhost, Django automatically falls back to in-memory LocMemCache.
# For production queuing with Upstash Redis or Redis Cloud:
# REDIS_URL=rediss://default:your_redis_token@your-endpoint.upstash.io:6379


# --- META / INSTAGRAM GRAPH API INTEGRATION ---
# Obtain from Meta for Developers (https://developers.facebook.com)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=https://monkhq.in/social/callback/
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_secret_verification_token
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_comments


# --- GOOGLE GEMINI AI ENGINE (MonkHQ AI Engine) ---
# Obtain from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional Token Safeguards
GEMINI_MAX_REQUESTS_PER_USER_HOUR=30
GEMINI_MAX_REQUESTS_PER_USER_DAY=120
GEMINI_MAX_DAILY_TOKENS_PER_USER=100000
